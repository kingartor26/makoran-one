{
  "name": "makoran-one-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Makoran One & Makoran Guard - Commercial AI CCTV & Security Platform",
  "workspaces": [
    "shared",
    "server",
    "agent",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:agent": "npm run dev --workspace=agent",
    "dev:client": "npm run dev --workspace=client",
    "build:client": "vite build --config client/vite.config.ts client",
    "build": "npm run build --workspaces --if-present && npm run build:client",
    "test": "node tests/vertical-slice.test.mjs && node tests/multi-tenancy.test.mjs && node tests/ai-priority.test.mjs && node tests/rule-engine.test.mjs && npx tsx tests/camera-discovery.test.mjs && npx tsx tests/saas-features.test.mjs && node tests/enterprise-scale.test.mjs"
  },
  "keywords": [
    "makoran",
    "cctv",
    "ai",
    "webrtc",
    "security",
    "dvr",
    "nvr"
  ],
  "author": "Makoran One Team",
  "license": "Commercial",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.46.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
